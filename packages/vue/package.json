{
  "name": "@booki/vue",
  "version": "0.1.2",
  "description": "Booki for Vue (experimental) — agent-first accounting controls as Vue 3 components: the same rules, state and agent actions as @booki/react.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Walgermo/booki.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/Walgermo/booki#readme",
  "keywords": [
    "accounting",
    "agents",
    "vue",
    "vue3",
    "voucher",
    "invoice"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@booki/core": "workspace:*",
    "@booki/primitives": "workspace:*"
  },
  "peerDependencies": {
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/vue": "0.1.0-beta.16",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/vue": "0.1.0-beta.16",
    "vue": "^3.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
