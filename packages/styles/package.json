{
  "name": "@booki-aui/styles",
  "version": "0.4.3",
  "description": "Booki default look — Paper and Ink tokens and data-slot styles, with the agent cursor. Optional.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Walgermo/booki.git",
    "directory": "packages/styles"
  },
  "homepage": "https://booki.dev/docs/installation",
  "bugs": {
    "url": "https://github.com/Walgermo/booki/issues"
  },
  "keywords": [
    "accounting",
    "css",
    "design-tokens",
    "nordic"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/css.d.ts",
      "style": "./dist/booki.css",
      "default": "./dist/booki.css"
    },
    "./booki.css": {
      "types": "./dist/css.d.ts",
      "style": "./dist/booki.css",
      "default": "./dist/booki.css"
    },
    "./layered.css": {
      "types": "./dist/css.d.ts",
      "style": "./dist/layered.css",
      "default": "./dist/layered.css"
    },
    "./shadcn.css": {
      "types": "./dist/css.d.ts",
      "style": "./dist/shadcn.css",
      "default": "./dist/shadcn.css"
    },
    "./base.css": {
      "types": "./dist/css.d.ts",
      "style": "./dist/base.css",
      "default": "./dist/base.css"
    },
    "./controls/*.css": {
      "types": "./dist/css.d.ts",
      "style": "./dist/controls/*.css",
      "default": "./dist/controls/*.css"
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "lightningcss": "1.33.0"
  }
}
