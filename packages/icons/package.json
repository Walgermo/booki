{
  "name": "@booki-aui/icons",
  "version": "0.5.0",
  "description": "Booki's duotone icons for accounting UI: SVG files, their markup as strings, and a small React component.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Walgermo/booki.git",
    "directory": "packages/icons"
  },
  "homepage": "https://booki.dev/docs/icons",
  "bugs": {
    "url": "https://github.com/Walgermo/booki/issues"
  },
  "keywords": [
    "accounting",
    "icons",
    "svg",
    "duotone"
  ],
  "sideEffects": false,
  "files": [
    "*.svg",
    "lib",
    "README.md",
    "COVERAGE.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./react": {
      "types": "./lib/react.d.ts",
      "default": "./lib/react.js"
    },
    "./svg/*.svg": "./*.svg"
  },
  "scripts": {
    "generate": "node ./scripts/generate.mjs",
    "rebuild": "node ./scripts/rebuild.mjs",
    "test": "node ./scripts/generate.mjs --check && node --test scripts/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "react": "^19.2.0"
  }
}
